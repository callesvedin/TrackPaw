    "allow.tracking.info" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must allow the application to track you. Preferably while the application is not in use to be able to put away your phone while tracking with your dog.\nYou may always change this setting in Settings->TrackPaw->Location"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du måste tillåta att appen spårar dig. Helst även när den är avstängd för att du ska kunna stoppa undan telefonen medan du spårar.\nDu kan ändra den här inställningen under Inställningar->TrackPaw->Plats"
          }
