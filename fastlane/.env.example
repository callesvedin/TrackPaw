# Copy to fastlane/.env (gitignored) and fill in.

# App Store Connect API key (https://appstoreconnect.apple.com/access/integrations/api)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# App Review contact, used by `fastlane release`
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_EMAIL=
REVIEW_PHONE=
