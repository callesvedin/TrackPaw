require "fileutils"
require "shellwords"

default_platform(:ios)

XCODEPROJ = "TrackPaw.xcodeproj"
SCHEME = "TrackPaw"

platform :ios do
  # Values live in fastlane/.env (gitignored), which fastlane loads
  # automatically; fastlane/.env.example lists every variable.
  def require_env(*names)
    missing = names.select { |name| ENV[name].to_s.strip.empty? }
    UI.user_error!("Set #{missing.join(', ')} in fastlane/.env (see fastlane/.env.example)") unless missing.empty?
    names.map { |name| ENV[name] }
  end

  def asc_api_key
    key_id, issuer_id, key_path = require_env("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_PATH")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: File.expand_path(key_path),
      in_house: false
    )
  end

  desc "Build and upload a new beta build to TestFlight"
  lane :beta do
    api_key = asc_api_key

    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: (latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1).to_s
    )

    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: "./build",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    add_git_tag(tag: "#{get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)}(#{get_build_number(xcodeproj: XCODEPROJ)})")
  end

  desc "Upload metadata, screenshots and the latest TestFlight build to the App Store"
  desc "Pass submit:true to also submit for review. Release after approval stays manual."
  lane :release do |options|
    metadata_path = File.expand_path("metadata", __dir__)
    screenshots_path = File.expand_path("screenshots", __dir__)

    first_name, last_name, email, phone =
      require_env("REVIEW_FIRST_NAME", "REVIEW_LAST_NAME", "REVIEW_EMAIL", "REVIEW_PHONE")

    # App Store Connect rejects a submission with these empty, but only after
    # the upload has run, so fail up front instead.
    missing = Dir[File.join(metadata_path, "*", "{privacy_url,support_url}.txt")]
              .select { |path| File.read(path).strip.empty? }
    UI.user_error!("Fill in before releasing:\n#{missing.join("\n")}") unless missing.empty?
    UI.user_error!("No screenshots in #{screenshots_path} — run `fastlane screenshots` first") if
      Dir[File.join(screenshots_path, "en-US", "*.png")].empty?

    api_key = asc_api_key
    version = get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)

    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: latest_testflight_build_number(api_key: api_key, version: version).to_s,
      skip_binary_upload: true,
      metadata_path: metadata_path,
      screenshots_path: screenshots_path,
      overwrite_screenshots: true,
      app_review_information: {
        first_name: first_name,
        last_name: last_name,
        email_address: email,
        phone_number: phone
      },
      submit_for_review: options[:submit] == true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      # Skips the interactive HTML preview so the lane can run unattended.
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Capture App Store screenshots"
  lane :screenshots do
    # `ScreenshotTests` writes this file (containing its simulator's UDID)
    # once the tracking map is open, and the watcher spawned below answers
    # by starting the walk and deleting it — the test waits for the deletion
    # before tapping "Start". The simulator reaches it through
    # SIMULATOR_HOST_HOME, the same host cache directory SnapshotHelper
    # already writes screenshots to. Starting the walk on request, rather
    # than on a timer, means every language's test gets a fresh walk from
    # the first waypoint exactly when it needs one, however long the build
    # or the previous language took.
    walk_request = File.expand_path("~/Library/Caches/tools.fastlane/walk_request")
    FileUtils.rm_f(walk_request)

    # A watcher from a previous run that was killed (Ctrl-C, closed
    # terminal) before its `ensure` block ran would otherwise still be alive
    # and answer this run's requests with that run's waypoints. The request
    # file name is unique to this lane, so matching on it is safe; pkill
    # skips its own ancestors, so this doesn't kill the shell running it.
    sh("pkill -f 'walk_request' 2>/dev/null || true", log: false)

    # The location permission alert is a system UI element that renders in
    # the Simulator's system language, not the app's `-AppleLanguages`
    # launch argument, so on a host whose simulator isn't English or
    # Swedish `ScreenshotTests`' interruption monitor would never match and
    # the run would hang on the alert. Granting the permission up front via
    # simctl skips the alert entirely, which sidesteps that problem instead
    # of chasing more button-label translations. This targets every
    # simulator matching a name from the Snapfile's `devices` list (not
    # just the one `snapshot` happens to pick), read via
    # `snapshot_device_names` below so the two never drift apart.
    device_names = snapshot_device_names
    pattern = device_names.map { |name| Regexp.escape(name) }.join("|")
    udids = sh(
      "xcrun simctl list devices available | grep -E '#{pattern}' | " \
      "grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' || true",
      log: false
    ).split("\n")
    UI.user_error!("No available simulators matched #{device_names} from the Snapfile — " \
                    "location permission was not granted anywhere, so `snapshot` would boot " \
                    "an ungranted device.") if udids.empty?

    # Walking pace fed to `simctl location start` below. Needs to be fast
    # enough that the segment covered during the ~20s screenshot wait is
    # clearly visible rather than a few-meter sliver, not to model a real
    # dog-walking pace. Route drawn in gpx.studio and converted with
    # `fastlane/gpx_to_waypoints.rb <path.gpx> [speed_m_s]`, which also
    # rewrites this value and the summary line below. The route must take
    # longer to walk than the ~25s the test tracks for, or the path stops
    # growing before the screenshot.
    walk_speed_m_s = 4
    # Current route: ~0.46km, 20 waypoints, ~116s to walk once at 4.0 m/s.
    waypoints = [
      "56.659066,16.319496", "56.659166,16.319910", "56.659193,16.320727", "56.659193,16.320738",
      "56.659402,16.320953", "56.659639,16.321053", "56.659857,16.321036", "56.660030,16.320904",
      "56.660212,16.320804", "56.660449,16.320821", "56.660640,16.320854", "56.660877,16.320970",
      "56.661068,16.321053", "56.661393,16.321086", "56.661576,16.320837", "56.661769,16.320671",
      "56.661985,16.320485", "56.662156,16.320589", "56.662316,16.320754", "56.662430,16.320920"
    ].join(" ")

    watcher_pid = nil

    # Everything that grants a permission or spawns the watcher lives inside
    # this `begin`, not just the `snapshot` call, so that a later `sh(...)`
    # raising (e.g. the privacy grant failing on a second device) still runs
    # the `ensure` cleanup below instead of leaving the watcher behind.
    begin
      udids.each do |udid|
        # `simctl privacy grant` requires a booted device. It's shut down
        # again afterwards so a matching device that `snapshot` doesn't
        # pick isn't left running.
        sh("xcrun simctl boot #{udid} 2>/dev/null || true")
        sh("xcrun simctl privacy #{udid} grant location-always se.cjs.TrackPaw")
        sh("xcrun simctl shutdown #{udid} 2>/dev/null || true")
      end

      # Starts the walk on the simulator named in the request, then deletes
      # the request so the waiting test knows it's running (see
      # `walk_request` above). Falls back to "booted" if the test couldn't
      # tell which simulator it's on. Runs in its own process group so the
      # `ensure` block can kill it and its `sleep` child in one signal.
      request = Shellwords.escape(walk_request)
      watcher_pid = Process.spawn(
        "while true; do if [ -f #{request} ]; then " \
        "udid=$(cat #{request}); [ -n \"$udid\" ] || udid=booted; " \
        "xcrun simctl location \"$udid\" start --speed=#{walk_speed_m_s} --interval=1 #{waypoints}; " \
        "rm -f #{request}; fi; sleep 0.5; done",
        out: File::NULL,
        pgroup: true
      )

      # `TEST_RUNNER_`-prefixed environment variables on the `xcodebuild`
      # process are forwarded to the test runner with the prefix stripped, so
      # `ScreenshotTests` sees this as `SCREENSHOT_LANE` and knows the watcher
      # above will answer its walk request, rather than skipping itself as it
      # does under a plain `xcodebuild test`. Setting it here (before
      # `snapshot` spawns its `xcodebuild`) is enough, since that child
      # process inherits this one's environment.
      ENV["TEST_RUNNER_SCREENSHOT_LANE"] = "1"
      snapshot
    ensure
      # Guaranteed cleanup on every exit path (success, test failure, or
      # interrupt): reap the watcher, stop the walk on every device it was
      # granted on, and revoke the location grant so the device is left
      # exactly as it was found — so a later run through the
      # permission-request or denied path still sees the real system prompt.
      # Each step is rescued individually so an already-exited watcher or
      # already-stopped scenario can't mask the real lane result.
      if watcher_pid
        begin
          # Signal the whole process group (negative pid) so the `sleep` child
          # dies too, rather than waiting for bash to notice the TERM.
          Process.kill("TERM", -watcher_pid)
          Process.wait(watcher_pid)
        rescue StandardError
          # Already gone (Errno::ESRCH/ECHILD), or its pid got recycled by
          # the OS for something we don't own (Errno::EPERM) — either way
          # there's nothing of ours left to signal or reap.
        end
      end
      FileUtils.rm_f(walk_request)

      udids.each do |udid|
        # `simctl location` has no `stop` action — `clear` is the documented
        # way to stop a running scenario (and is a no-op, not an error, if
        # the device already shut down before this ran).
        sh("xcrun simctl location #{udid} clear 2>/dev/null || true", log: false)
        sh("xcrun simctl privacy #{udid} reset location se.cjs.TrackPaw 2>/dev/null || true", log: false)
      end
    end

    # Puts a *copy* of every captured screenshot in an iPhone device frame
    # (via frameit), for marketing/preview use — never the originals in
    # "screenshots/", which `release` uploads to App Store Connect. A
    # frameit device bezel enlarges the canvas beyond Apple's exact
    # required screenshot resolution (e.g. the iPhone 17 Pro Max's
    # 1320x2868 screenshot becomes a 1470x3000 framed image), which fails
    # ASC validation; worse, `deliver` auto-detects a "_framed.png"
    # sibling in a locale folder and uploads *that* instead of the
    # original, so a framed file left next to the originals would silently
    # break `release`. Framing a separate copy sidesteps both problems.
    screenshots_path = File.expand_path("screenshots", __dir__)
    framed_path = File.expand_path("screenshots_framed", __dir__)
    FileUtils.rm_rf(framed_path)
    FileUtils.cp_r(screenshots_path, framed_path)
    frame_screenshots(path: framed_path)
    # Drop the unframed copies `frame_screenshots` needed as its source,
    # and the stale HTML index of them, so this directory holds only the
    # finished framed images.
    Dir.glob(File.join(framed_path, "**", "*.png")).each do |path|
      File.delete(path) unless path.end_with?("_framed.png")
    end
    FileUtils.rm_f(File.join(framed_path, "screenshots.html"))
  end

  # `devices` in the Snapfile is the one canonical list of target
  # simulators. Reading it here — instead of repeating a device name in
  # this Fastfile — means the grant loop above can never target different
  # hardware than `snapshot` boots.
  def snapshot_device_names
    snapfile = File.read(File.expand_path("Snapfile", File.dirname(__FILE__)))
    match = snapfile[/devices\(\s*(\[.*?\])\s*\)/m, 1]
    UI.user_error!("Could not find a `devices([...])` list in Snapfile") unless match

    names = match.scan(/["']([^"']*)["']/).flatten
    UI.user_error!("Found a `devices([...])` list in Snapfile but no quoted device names inside it") if names.empty?
    names
  end
end
